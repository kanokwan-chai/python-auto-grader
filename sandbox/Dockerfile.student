FROM python:3.11-slim

# Create unprivileged student user with no login shell and no sudo
RUN groupadd --gid 10001 student \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin student

# Remove unnecessary networking/system utilities to minimize attack surface
RUN rm -rf /var/lib/apt/lists/* /usr/bin/curl /usr/bin/wget || true

WORKDIR /workspace
USER 10001:10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    HOME=/tmp
