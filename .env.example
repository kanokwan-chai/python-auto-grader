# ============================================================================
# Python Auto Grader — Environment Configuration Example
# Copy to .env and fill in real credentials before running.
# ============================================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=replace-with-64-char-random-secret
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase PostgreSQL or Local Docker Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pyautograder

# --- Supabase Auth & Private Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
STORAGE_BUCKET_NAME=submissions
# Set STORAGE_BACKEND=local only for offline local dev without Supabase Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/pyautograder_storage

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Google OAuth 2.0 / Classroom / Drive API ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-valid-fernet-key=

# --- Isolated Python Sandbox Service (Deploy on separate host in production) ---
SANDBOX_SERVICE_URL=http://sandbox:8080
SANDBOX_API_KEY=replace-with-internal-sandbox-shared-key
SANDBOX_DOCKER_IMAGE=pyautograder-student-python:3.11
# Use "runsc" (gVisor) in production Linux hosts; leave empty for default Docker runtime in local dev
SANDBOX_DOCKER_RUNTIME=
SANDBOX_MAX_CONCURRENT_JOBS=8
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_PIDS_LIMIT=64

# --- AI Code Review (OpenAI-compatible LLM API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
